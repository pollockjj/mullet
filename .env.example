MODEL_BASE_URL=http://127.0.0.1:1234/v1
MODEL_ID=local-model
MODEL_DEFAULT_TOKENS=65536
MODEL_MAX_TOKENS=128000
MODEL_TEMPERATURE=0.85
# Lanes split by pipeline, not media type. Expression still+motion own one instance,
# scene still+motion own the other, so the two pipelines never queue behind each other.
EXPRESSION_COMFY_BASE_URL=http://firestorm:8188
SCENE_COMFY_BASE_URL=http://firestorm:8189
BUILD_SHA=development
PUBLIC_BUILD_SHA=development
BASE_PATH=
HOST=127.0.0.1
PORT=8781
BODY_SIZE_LIMIT=32M
# Sampling per the Hugging Face model card (Gemma 4 recommendations): temperature 1.0, top_p 0.95, top_k 64
MODEL_TEMPERATURE=1.0
MODEL_TOP_P=0.95
MODEL_TOP_K=64
MODEL_MAX_TOKENS=262144
MODEL_CONTEXT_TOKENS=262144
