{
  "name": "mullet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js dev",
    "build": "node node_modules/vite/bin/vite.js build",
    "check": "node node_modules/@sveltejs/kit/svelte-kit.js sync && node node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "start": "node scratch/build/index.js"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
